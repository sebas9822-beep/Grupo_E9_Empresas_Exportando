# Datos originales completos (~1,5 GB): se regeneran con los pasos 1, 2 y 5 o se apuntan con EXPO_RAW_DIR.
# Solo se versionan el README y la muestra en CSV (regla de la plantilla del curso)
datos/originales/*
!datos/originales/README.md
!datos/originales/muestra_*.csv

# Intermedios regenerables (incluye los productos de los pasos 7 y 8, insumo del paso 9)
datos/intermedios/
*.duckdb
*.duckdb.wal
.tmp/
*.part

# Python / entornos / editores
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/
.vscode/
.idea/
.DS_Store
Thumbs.db
~$*.xlsx
